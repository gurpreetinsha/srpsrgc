# ==============================================================================
# SRGC Student Result Management System — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT:
# Run via docker-compose or local Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/srgc_dev?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/srgc_dev?schema=public"

# STAGING & PRODUCTION (Neon Serverless PostgreSQL):
# Pooled connection string (PgBouncer) for runtime queries:
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/srgc_prod?sslmode=require&pgbouncer=true"

# Unpooled direct connection string used strictly for migrations (`prisma migrate deploy`):
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/srgc_prod?sslmode=require"

# ------------------------------------------------------------------------------
# 2. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV="development" # Set to "production" in production environments
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="SRGC Result Management System"
PORT=3000

# ------------------------------------------------------------------------------
# 3. SECURITY & SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# Cookie configuration
# In production, secure cookies are automatically enforced when NODE_ENV=production.
SESSION_COOKIE_NAME="srgc_session"
SESSION_MAX_AGE_SECONDS=86400 # 24 hours

# CSRF & Origin Validation
# Comma-separated list of trusted origins for mutating requests
TRUSTED_ORIGINS="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. RATE LIMITING
# ------------------------------------------------------------------------------
# Max login attempts before temporary lockout
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300 # 5 minutes

# ------------------------------------------------------------------------------
# 5. OPTIONAL EMAIL SERVICE PROVIDER
# ------------------------------------------------------------------------------
# If unconfigured, the system explicitly disables email dispatch and relies on in-app notifications.
# Never invent mock email delivery.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

