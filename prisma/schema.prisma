generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Temporary placeholder model for Phase 0 validation
model SystemPing {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}
